SECRET_KEY=<generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())">
DEBUG=false
DB_NAME=<your_db_name>
DB_USER=<your_db_user>
DB_PASSWORD=<your_db_password>
DB_HOST=<your_db_host>
DB_PORT=5432
PAYMONGO_SECRET_KEY=<sk_test_... or sk_live_...>
PAYMONGO_WALLET_ID=<wallet_...>
PAYMONGO_CASHOUT_CALLBACK_URL=https://your-api.example.com/api/wallet/paymongo/callback/
CASHOUT_PROVIDER_FEE_PHP=10
CASHOUT_MIN_PHP=500
FRONTEND_URL=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# Email transport. Preference order: Resend (RESEND_API_KEY) > SMTP > console (DEBUG only).
# DEFAULT_FROM_EMAIL is required for whichever transport is used.
DEFAULT_FROM_EMAIL=StudyBuddy <onboarding@resend.dev>

# Resend (https://resend.com) via django-anymail. Recommended.
# onboarding@resend.dev only delivers to your own Resend-account email until you verify a domain.
RESEND_API_KEY=<re_...>

# SMTP email (legacy fallback). Used only when RESEND_API_KEY is unset.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=<smtp_password>
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10
