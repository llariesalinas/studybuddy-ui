SECRET_KEY=<generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())">
DEBUG=false
DB_NAME=<your_db_name>
DB_USER=<your_db_user>
DB_PASSWORD=<your_db_password>
DB_HOST=<your_db_host>
DB_PORT=5432
PAYMONGO_SECRET_KEY=<sk_test_... or sk_live_...>
PAYMONGO_WALLET_ID=<wallet_...>
PAYMONGO_CASHOUT_CALLBACK_URL=https://your-api.example.com/api/wallet/paymongo/callback/
PAYMONGO_CASHOUT_CALLBACK_SECRET=<random-shared-secret>
# Dev only: PayMongo test mode has no Money Movement/payouts product, so there is no
# test wallet ID to configure. Set to true locally to simulate a successful cash-out
# without calling PayMongo. Never enable in production.
PAYMONGO_CASHOUT_MOCK=false
CASHOUT_PROVIDER_FEE_PHP=10
CASHIN_MIN_PHP=50
CASHOUT_MIN_PHP=50
FRONTEND_URL=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# Email transport. Preference order: Resend (RESEND_API_KEY) > SMTP > console (DEBUG only).
# DEFAULT_FROM_EMAIL is required for whichever transport is used.
DEFAULT_FROM_EMAIL=StudyBuddy <onboarding@resend.dev>

# Resend (https://resend.com) via django-anymail. Recommended.
# onboarding@resend.dev only delivers to your own Resend-account email until you verify a domain.
RESEND_API_KEY=<re_...>

# SMTP email (legacy fallback). Used only when RESEND_API_KEY is unset.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=<smtp_password>
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10

# Dev only: enables the self-service verification dev panel (state jumper + booking-gate
# enforcement override) on the profile pages and the SuperAdmin verification dev tools. The
# endpoints 403 unless this is true. Never enable in production. The enforcement override is
# cache-backed, so set REDIS_URL for it to persist across processes (otherwise it lives in the
# single dev process only).
VERIFICATION_DEV_TOOLS_ENABLED=false

# Redis cache — used for dashboard recommendation caching. Optional in dev (the app
# falls back to a per-process in-memory cache when unset). Required in multi-worker
# production so the cache is shared and invalidation works across processes.
REDIS_URL=redis://127.0.0.1:6379/1
